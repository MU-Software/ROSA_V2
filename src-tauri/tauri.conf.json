{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ROSA",
  "version": "0.1.0",
  "identifier": "com.musoftware.rosa",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ROSA",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "iOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "15.0",
      "developmentTeam": "NBM824WDPS"
    }
  }
}
